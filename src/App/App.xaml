<Application x:Class="Nodestar.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B1120" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#111827" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#1F2937" />
        <SolidColorBrush x:Key="AccentBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#3B2A10" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F9FAFB" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9CA3AF" />
    </Application.Resources>
</Application>
