<Window x:Class="Nodestar.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="nodestar"
        Width="420"
        Height="920"
        MinWidth="360"
        MinHeight="640"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Topmost="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="IconGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#182132" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#243042" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Background" Value="#111827" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#253149" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#172235" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#1E2A40" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusPillButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="14,0,0,0" />
            <Setter Property="Background" Value="#141D2C" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#253149" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="StatusPillSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StatusPillSurface" Property="Background" Value="#1A2538" />
                                <Setter Property="BorderBrush" Value="#31425F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StatusPillSurface" Property="Background" Value="#21314A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowSurface"
            Margin="10"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                    Padding="24,22,20,20"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="0,0,0,1"
                    PreviewMouseLeftButtonDown="HeaderBar_OnPreviewMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Text="Nodestar Companion" />
                            <Button x:Name="StatusPillButton"
                                    Style="{StaticResource StatusPillButtonStyle}"
                                    ToolTip="Manage SW Connection"
                                    Click="StatusPillButton_OnClick">
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="StatusContextMenu">
                                        <MenuItem x:Name="CloseSolidWorksMenuItem"
                                                  Header="Close SOLIDWORKS instance"
                                                  Click="CloseSolidWorksMenuItem_OnClick" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusIndicator"
                                             Width="10"
                                             Height="10"
                                             VerticalAlignment="Center"
                                             Fill="#F59E0B">
                                        <Ellipse.Effect>
                                            <DropShadowEffect x:Name="StatusIndicatorGlow"
                                                              BlurRadius="14"
                                                              ShadowDepth="0"
                                                              Color="#F59E0B"
                                                              Opacity="0.95" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock x:Name="StatusTextBlock"
                                               Margin="10,0,6,0"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="Connecting" />
                                    <TextBlock Style="{StaticResource IconGlyphStyle}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="&#xE70D;" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock Margin="0,8,0,0"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="Ask, inspect, and drive SOLIDWORKS." />
                        <TextBlock Margin="0,10,0,0"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="Launches SOLIDWORKS beside Nodestar, then keeps the companion workflow visible while you prompt and inspect." />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource ChromeButtonStyle}"
                                ToolTip="Settings"
                                Click="SettingsButton_OnClick">
                            <TextBlock Style="{StaticResource IconGlyphStyle}" Text="&#xE713;" />
                        </Button>
                        <Button Style="{StaticResource ChromeButtonStyle}"
                                ToolTip="Dock to right of screen"
                                Click="ResetWindowPositionButton_OnClick">
                            <TextBlock Style="{StaticResource IconGlyphStyle}" Text="&#xE89F;" />
                        </Button>
                        <Button Style="{StaticResource ChromeButtonStyle}"
                                ToolTip="Minimize"
                                Click="MinimizeButton_OnClick">
                            <TextBlock Style="{StaticResource IconGlyphStyle}" Text="&#xE921;" />
                        </Button>
                        <Button Style="{StaticResource ChromeButtonStyle}"
                                ToolTip="Maximize or restore"
                                Click="MaximizeRestoreButton_OnClick">
                            <TextBlock x:Name="MaximizeRestoreIcon"
                                       Style="{StaticResource IconGlyphStyle}"
                                       Text="&#xE922;" />
                        </Button>
                        <Button Style="{StaticResource ChromeButtonStyle}"
                                ToolTip="Close"
                                Click="CloseButton_OnClick">
                            <TextBlock Style="{StaticResource IconGlyphStyle}" Text="&#xE8BB;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,24,24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <WrapPanel Margin="0,0,0,16">
                    <Border Margin="0,0,10,10"
                            Padding="14,8"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="#5A3E10"
                            BorderThickness="1"
                            CornerRadius="15">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" />
                            <TextBlock Margin="10,0,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Companion shell" />
                        </StackPanel>
                    </Border>

                    <Button Margin="0,0,10,10"
                            Style="{StaticResource GhostActionButtonStyle}"
                            Content="Open assembly" />
                    <Button Margin="0,0,10,10"
                            Style="{StaticResource GhostActionButtonStyle}"
                            Content="Add feature" />
                    <Button Margin="0,0,0,10"
                            Style="{StaticResource GhostActionButtonStyle}"
                            Content="Review drawing" />
                </WrapPanel>

                <ScrollViewer x:Name="ConversationScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ConversationPanel" />
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2"
                    Margin="24,4,24,24"
                    Padding="18"
                    Background="#0F172A"
                    BorderBrush="#23314B"
                    BorderThickness="1"
                    CornerRadius="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Prompt" />

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Margin="0,0,12,0">
                            <TextBox x:Name="PromptTextBox"
                                     Padding="16,14"
                                     Background="#0B1120"
                                     BorderBrush="#253149"
                                     BorderThickness="1"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     FontSize="14"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="88"
                                     VerticalContentAlignment="Top"
                                     TextChanged="PromptTextBox_OnTextChanged"
                                     PreviewKeyDown="PromptTextBox_OnPreviewKeyDown" />
                            <TextBlock Margin="18,16,120,16"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       IsHitTestVisible="False"
                                       TextWrapping="Wrap"
                                       Text="Describe the model change, inspection task, or question you want Nodestar to handle. Press Enter to send, Shift+Enter for a newline.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=PromptTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button x:Name="SendButton"
                                Grid.Column="1"
                                Width="92"
                                Height="48"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                Content="Send"
                                Click="SendButton_OnClick" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
