<Window x:Class="Nodestar.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="nodestar — settings"
        Width="480"
        Height="360"
        MinWidth="400"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Margin="8"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Padding="24,18,16,16"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="0,0,0,1"
                    PreviewMouseLeftButtonDown="Header_OnPreviewMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="Nodestar Companion" />
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="LLM Settings" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="32" Height="32"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            VerticalAlignment="Top"
                            Click="CloseButton_OnClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe Fluent Icons"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="&#xE8BB;" />
                    </Button>
                </Grid>
            </Border>

            <!-- Fields -->
            <StackPanel Grid.Row="1" Margin="24,20,24,16" VerticalAlignment="Top">

                <TextBlock FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,6"
                           Text="API Base URL" />
                <TextBox x:Name="BaseUrlBox"
                         Padding="14,10"
                         Background="#0B1120"
                         BorderBrush="#253149"
                         BorderThickness="1"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="13"
                         Margin="0,0,0,16" />

                <TextBlock FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,6"
                           Text="API Key" />
                <PasswordBox x:Name="ApiKeyBox"
                             Padding="14,10"
                             Background="#0B1120"
                             BorderBrush="#253149"
                             BorderThickness="1"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="13"
                             Margin="0,0,0,16" />

                <TextBlock FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,6"
                           Text="Model" />
                <TextBox x:Name="ModelBox"
                         Padding="14,10"
                         Background="#0B1120"
                         BorderBrush="#253149"
                         BorderThickness="1"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="13" />
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Padding="24,12,24,20"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Margin="0,0,10,0"
                            Padding="20,10"
                            Background="#111827"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="#253149"
                            BorderThickness="1"
                            FontSize="13"
                            Cursor="Hand"
                            Content="Cancel"
                            Click="CancelButton_OnClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="12">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#172235" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="SaveButton"
                            Padding="20,10"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="#111827"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Content="Save"
                            Click="SaveButton_OnClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="12">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#D97706" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
